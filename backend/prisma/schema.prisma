generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String
  password    String
  role        Role      @default(STUDENT)
  avatarUrl   String?
  isVerified  Boolean   @default(false)
  verifyToken String?   @unique
  tokenExpiry DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // WhatsApp verification (set on onboarding Step 6)
  whatsappPhone    String?  // E.164 format, e.g. +2347012345678
  whatsappVerified Boolean  @default(false)

  // Dual-role access flags — the canonical source of truth for which profiles exist
  hasStudentAccess Boolean @default(false)
  hasCreatorAccess Boolean @default(false)

  profile             Profile?
  studentProfile      StudentProfile?
  instructorProfile   InstructorProfile?
  enrollments         Enrollment[]
  courses             Course[]                @relation("InstructorCourses")
  orders              Order[]
  reviews             Review[]
  onboardingDraft     CreatorOnboardingDraft?
  PasswordResetToken  PasswordResetToken[]
  onboardingSession   OnboardingSession?
  accessEntitlements  CourseAccessEntitlement[]
  courseSubscriptions CourseSubscription[]

  // Social Connections — Followers & Following
  following UserFollow[] @relation("UserFollower")
  followers UserFollow[] @relation("UserFollowing")

  // Account Security, Status & Lifecycle fields (Part 3A.2.1.2.1)
  accountStatus        AccountStatus @default(ACTIVE)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  lastActiveAt         DateTime?
  loginCount           Int           @default(0)
  failedLoginAttempts  Int           @default(0)
  accountLockedUntil   DateTime?
  deletedAt            DateTime?

  // Failed verify-code submissions; at >= 5 the pending code is voided (B1)
  verifyAttempts       Int           @default(0)

  // Persisted timezone — captured opportunistically from the client (see
  // TimezoneInterceptor). The Tey scheduler cannot ask a browser "what time is
  // it for you?" at 8pm, so the learner's zone has to live in the database.
  // IANA is primary because it survives DST; the offset is a fallback for
  // clients that can't resolve a zone name, and mirrors the existing
  // x-timezone-offset header (same sign convention as Date.getTimezoneOffset).
  timezone              String?
  timezoneOffsetMinutes Int?

  gemTransactions    GemTransaction[]
  shopTransactions   ShopTransaction[]
  userAchievements   UserAchievement[]
  userMissions       UserMission[]
  dailyMissions      UserDailyMission[]
  dailyMissionSets   DailyMissionSet[]
  rewardTransactions RewardTransaction[]
  spinClaims         SpinClaim[]
  courseProgresses   UserCourseProgress[]
  lessonProgresses   UserLessonProgress[]
  stepProgresses     UserStepProgress[]
  stepAttempts       UserStepAttempt[]
  learningSessions   LearningSession[]
  userLearningStreak UserLearningStreak?
  userStats          UserStats?
  weeklyProgresses   UserWeeklyProgress[]
  weeklySpins        WeeklySpin[]
  learningEvents     LearningEvent[]
  userInventories    UserInventory[]
  dailyChests        DailyChest[]
  dailyActivities    UserDailyActivity[]
  monthlyQuests      UserMonthlyQuest[]
  userMomentum       UserMomentum?
  rewardLogs             RewardLog[]
  xpEvents               XpEvent[]
  communityMemberships   CommunityMembership[]
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  activityFeed           ActivityFeed[]
  viewerFriendActivities FriendActivity[]       @relation("ViewerFriendActivities")
  actorFriendActivities  FriendActivity[]       @relation("ActorFriendActivities")
  notifications          Notification[]
  notificationActors     Notification[]         @relation("NotificationActor")
  pollVotes              PollVote[]
  courseWeeklyXp         CourseWeeklyXp[]
  leagueMembers          LeagueMember[]
  teyActivityEvents      TeyActivityEvent[]
  learnerState           LearnerState?

  @@index([accountStatus, role])
  @@index([createdAt, role])
  @@index([lastLoginAt])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  LOCKED
  DELETED
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username             String?   @unique
  creatorStatus        String    @default("founding_creator")
  headline             String?
  bio                  String?   @db.Text
  about                String?   @db.Text
  avatarUrl            String?
  coverImageUrl        String?
  introVideoUrl        String?
  tagline              String?
  location             String?
  languages            Json?
  primaryExpertise     String?
  skills               Json?
  teachingLevels       Json?
  contentFormats       Json?

  // Experience, Education & Certifications
  experiences          Json?
  education            Json?
  certifications       Json?

  // Social & Professional Links
  website              String?
  linkedin             String?
  github               String?
  twitter              String?
  youtube              String?
  instagram            String?
  tiktok               String?
  facebook             String?
  portfolio            String?

  // Contact & Preferences
  contactMethod        String?   @default("email")
  businessEmail        String?
  allowCollaboration   Boolean   @default(true)
  profileVisibility    String    @default("PUBLIC")
  privacySettings      Json?

  usernameLastChangedAt DateTime?

  // Creator profile fields (hydrated from onboarding answers)
  niche            String? // Step 3: primary teaching category
  subCategories    Json? // Step 3: all selected categories
  audienceSize     String? // Step 4: audience scale
  platforms        Json? // Step 5: current platforms
  weeklyHours      String? // Step 9: available time per week
  biggestChallenge Json?   // Step 7: selected pain points (multi-select array from onboarding)
  teachingStyle    String? // Step 8: content/teaching approach
  launchGoal       String? // Step 12: first course launch goal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id               String  @id @default(uuid())
  title            String
  slug             String  @unique
  description      String  @db.Text
  shortDescription String?
  thumbnailUrl     String?
  price            Float
  originalPrice    Float?
  published        Boolean @default(false)

  // Teyro Course Transformation Engine
  category          String  @default("Uncategorized")
  level             String  @default("Beginner")
  duration          String  @default("0h")
  creatorTimeWeekly String?
  subtitle          String?
  startingPoint     String? @db.Text
  endOutcome        String? @db.Text
  realOutputs       Json?

  subcategory  String?
  language     String  @default("English")
  skills       Json? // Array of strings
  requirements Json? // Array of strings (Prerequisites)
  outcomes     Json? // Array of strings (What learners will achieve)

  rating        Float @default(0)
  reviewsCount  Int   @default(0)
  studentsCount Int   @default(0)

  curriculum Json? @default("[]")

  // Relations
  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])

  sections Section[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments          Enrollment[]
  accessEntitlements   CourseAccessEntitlement[]
  courseSubscriptions  CourseSubscription[]
  orderItems           OrderItem[]
  userCourseProgresses UserCourseProgress[]
  community            Community?
  posts                Post[]
  weeklyXpRows         CourseWeeklyXp[]
  views                CourseView[]

  // Catalog reads (GET /courses) filter on `published` and sort by
  // `createdAt` — previously a full table scan + sort on every catalog
  // load. `instructorId` backs every "my courses" / ownership-check query.
  @@index([published, createdAt])
  @@index([instructorId])
}

/// Daily page-view aggregate for a course detail page. One row per
/// (course, day), incremented on visit — powers funnel stage 1 ("viewed")
/// and the enrollment conversion rate. Never per-user, so nothing here can
/// identify a visitor.
model CourseView {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  count    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, day])
  @@index([courseId])
  @@map("course_views")
}

model Section {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  goal        String?  @db.Text
  orderIndex  Int      @default(0)
  isLocked    Boolean  @default(false)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id               String  @id @default(uuid())
  title            String  @db.VarChar(100)
  description      String? @db.Text
  shortDescription String? @db.VarChar(300)
  lessonType       String  @default("video")
  orderIndex       Int     @default(0)
  isFreePreview    Boolean @default(false)
  durationMinutes  Int     @default(0)

  // Status and versioning for optimistic locking and draft support
  status                   String    @default("draft") // draft, published, scheduled, archived
  version                  Int       @default(1)
  publishedAt              DateTime?
  estimatedDurationSeconds Int       @default(0)

  // Block-based content architecture
  contentBlocks Json? @default("{}")

  // Phase completion state tracking
  stepCompletion Json? @default("{\"learn\":false,\"apply\":false,\"reflect\":false,\"deepen\":false}")

  // System
  xpReward Int @default(10)

  // Relations
  sectionId String
  section   Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  steps     LessonStep[]
  userLessonProgresses UserLessonProgress[]
  posts     Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("course_lessons")
}

model LessonStep {
  id              String   @id @default(uuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  stepType        String   // 'learn' | 'apply' | 'reflect' | 'resources'
  title           String?
  orderIndex      Int      @default(0)
  isRequired      Boolean  @default(true)
  unlockCondition Json?

  contents         LessonStepContent[]
  userStepProgresses UserStepProgress[]
  userStepAttempts   UserStepAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([stepType])
  @@map("lesson_steps")
}

model LessonStepContent {
  id            String     @id @default(uuid())
  stepId        String
  step          LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  contentType   String     // 'video' | 'text' | 'quiz' | 'task' | 'ai_prompt' | 'file'
  content       Json
  orderIndex    Int        @default(0)
  isInteractive Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId])
  @@map("lesson_step_content")
}

model LessonResource {
  id               String  @id @default(uuid())
  lessonId         String
  lesson           Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type             String // pdf, pptx, fig, link, video
  title            String
  storageUrl       String
  sizeBytes        Int?
  originalName     String?
  estimatedReadMin Int     @default(0)
  displayOrder     Int     @default(0)
  description      String? // optional creator-written summary shown in resource lists
  category         String? // Reference | Template | Exercise | Supplemental

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id       String  @id @default(uuid())
  rating   Int // 1 to 5
  comment  String? @db.Text
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId]) // One review per user per course
}

model Enrollment {
  id               String   @id @default(uuid())
  userId           String
  courseId         String
  progress         Int      @default(0)
  completedLessons Json?    @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

enum AccessPlan {
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
}

enum AccessStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model CourseAccessEntitlement {
  id                   String       @id @default(uuid())
  userId               String
  courseId             String
  plan                 AccessPlan   @default(MONTHLY)
  status               AccessStatus @default(ACTIVE)
  startDate            DateTime     @default(now())
  expiresAt            DateTime
  cancelAtPeriodEnd    Boolean      @default(false)
  stripeSubscriptionId String?
  stripeCustomerId     String?
  pricePaid            Float?

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([userId, courseId])
  @@index([userId, courseId, status, expiresAt])
  @@map("course_access_entitlements")
}

/// Idempotency ledger for provider webhooks. Stripe (and other providers)
/// retry deliveries and legitimately fire overlapping events — without this
/// table every replay would stack another free period onto the entitlement.
model ProcessedWebhookEvent {
  id         String   @id @default(uuid())
  provider   String // STRIPE | MESOMB
  eventId    String
  eventType  String?
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}

enum PaymentProviderType {
  STRIPE
  MESOMB
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model CourseSubscription {
  id                     String              @id @default(uuid())
  userId                 String
  courseId               String
  provider               PaymentProviderType @default(STRIPE)
  providerSubscriptionId String?
  providerCustomerId     String?
  plan                   AccessPlan          @default(MONTHLY)
  status                 SubscriptionStatus  @default(ACTIVE)
  startedAt              DateTime            @default(now())
  currentPeriodStart     DateTime            @default(now())
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  endedAt                DateTime?
  autoRenew              Boolean             @default(true)
  pricePaid              Float?
  currency               String              @default("USD")

  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                 Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([userId, courseId, status])
  @@index([provider, providerSubscriptionId])
  @@map("course_subscriptions")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  price     Float // Price at the time of purchase
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model Waitlist {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  name              String?
  email             String?
  phone             String?
  discovery_channel String?
  role              String?
  raw_data          Json?
}

model CreatorOnboardingDraft {
  id        String   @id @default(uuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // Stores answers from steps 1-13
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model OnboardingSession {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStep    Int       @default(1)
  completedSteps Int[]     @default([])
  answers        Json      @default("{}")
  onboardingComplete Boolean @default(false)
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@map("onboarding_sessions")
}

model StudentProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Learning progress data
  xp                 Int       @default(30) // 30 XP starter grant
  streakDays         Int       @default(0)
  lastActiveAt       DateTime?
  lastStreakEarnedAt DateTime? // Exact timestamp when daily streak was last incremented

  // Lives system — lose a life on wrong Apply answer, refill 1 per 4h
  lives           Int       @default(5)
  maxLives        Int       @default(5)
  livesLastLostAt DateTime?  // timestamp of when the last life was lost

  // Streak freezes (banked freezes)
  streakFreezeBank Int       @default(1)

  // Daily quests log
  completedQuests  Json      @default("[]")
  lastQuestResetAt DateTime?

  // Achievements log — tracks which badge levels have been unlocked and claimed
  // Format: [{ badgeId, level, claimed, unlockedAt }]
  achievements Json @default("[]")

  // Daily Reward (Login Chest)
  lastRewardClaimedAt      DateTime?
  dailyRewardCyclePosition Int       @default(1)

  // Gems & Coins currency & longest streak tracking
  gems                  Int       @default(100) // 100 Gems starter grant
  coins                 Int       @default(50)  // 50 Coins starter grant
  longestStreak         Int       @default(3)
  lastLessonCompletedAt DateTime? // Exact timestamp when a lesson was finished

  // Daily goal (XP/day) — Duolingo-style commitment level
  // 20 Casual | 50 Regular | 100 Serious | 200 Intense
  dailyGoalXp           Int       @default(20)

  // Weekly league standing (Duolingo-style leaderboards). Source of truth for
  // which tier the user joins next week; mutated only by league settlement.
  leagueTier     LeagueTier @default(BRONZE)
  tournamentWins Int        @default(0) // Diamond Tournament championships

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // `userId` is already `@unique` above (which Postgres backs with its own
  // index) — the old `@@index([userId])` here was a pure duplicate that
  // only cost write throughput. `xp` backs the stats-summary percentile
  // (`count(*) where xp > $mine`), previously a full-table scan per read.
  @@index([xp])
  @@map("student_profiles")
}

model GemTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'EARN' | 'SPEND'
  amount    Int
  source    String   // 'LESSON' | 'DAILY_GOAL' | 'LEARNING_PATH' | 'LEVEL_UP' | 'PERFECT_LESSON' | 'SHOP' | 'CHALLENGE' | 'ONBOARDING_CHALLENGE' | 'ADMIN'
  createdAt DateTime @default(now())

  // NOTE: a PARTIAL unique index (userId WHERE source = 'ONBOARDING_CHALLENGE')
  // enforces the one-time onboarding challenge reward. Prisma can't model
  // partial indexes — it lives only in migration
  // 20260825120000_add_onboarding_challenge_reward_guard.
  @@index([userId])
  @@map("gem_transactions")
}

model ShopTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      String   // 'REFILL_HEARTS' | 'STREAK_FREEZE'
  quantity  Int      @default(1)
  cost      Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("shop_transactions")
}

model WhatsappAuthStore {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("whatsapp_auth_store")
}

// One-time WhatsApp verification codes (onboarding Step 6 + profile settings).
// Keyed by normalised E.164 phone — one pending code per number.
// `codeHash` is SHA-256(code + phone); raw codes are never persisted.
//
// Anonymous journeys: onboarding users verify BEFORE signing up (Google sign-in
// happens at Step 12). A successful anonymous verify stamps `verifiedAt` instead
// of deleting the row; when the user later syncs onboarding answers while
// authenticated, user-onboarding.service claims the row (`claimedBy`) and binds
// the number to the account.
model WhatsappOtp {
  phone           String    @id // E.164, e.g. +237671405008
  codeHash        String
  expiresAt       DateTime // 10-minute TTL from send
  attempts        Int       @default(0) // wrong guesses; locked & deleted at MAX_OTP_ATTEMPTS
  sentCount       Int       @default(0) // sends within the current hourly window
  windowStartedAt DateTime  @default(now()) // start of the current hourly send window
  lastSentAt      DateTime  @default(now()) // enforces the resend cooldown
  verifiedAt      DateTime? // set when verified pre-auth (row kept for account binding)
  claimedBy       String? // userId that bound this number, once known
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("whatsapp_otps")
}

// One-time Step 9 onboarding challenge reward, claimed BEFORE sign-up.
// The client celebrates immediately; the payout settles when the account
// appears (signup paths + authenticated session syncs). `tokenHash` is the
// SHA-256 of an opaque token shown once to the browser — the raw value is
// never stored. `settledByUserId` being UNIQUE means one settled claim per
// account AND one settling account per claim; per-user once-only payout is
// additionally enforced by the gem_transactions partial unique index
// (migration 20260825120000).
model OnboardingChallengeClaim {
  tokenHash       String    @id
  phone           String? // E.164 fallback reconciliation key when WhatsApp verified pre-signup
  expiresAt       DateTime // 30-day settlement window from issue
  settledByUserId String?   @unique
  settledAt       DateTime?
  createdAt       DateTime  @default(now())

  @@map("onboarding_challenge_claims")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String    // 'wildfire' | 'sage' | 'champion' | 'sharpshooter' | 'explorer' | 'marathon'
  tier          Int       @default(1)
  unlockedAt    DateTime  @default(now())
  // Achievements are their own reward — seenAt only tracks whether the student
  // has viewed the unlock (celebration scene / collection) so Herald stops nudging.
  seenAt        DateTime?

  @@unique([userId, achievementId, tier])
  @@index([userId])
  @@map("user_achievements")
}

model UserMission {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionKey String    // 'COMPLETE_LESSON' | 'MAINTAIN_STREAK' | 'LEARN_MINUTES'
  progress   Int       @default(0)
  target     Int       @default(1)
  completed  Boolean   @default(false)
  claimedAt  DateTime?
  dateStr    String    // YYYY-MM-DD local date string

  @@unique([userId, missionKey, dateStr])
  @@index([userId, dateStr])
  @@map("user_missions")
}

model SpinClaim {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType String   // 'COINS' | 'XP' | 'FREEZE' | 'HEARTS'
  rewardVal  Int
  claimedAt  DateTime @default(now())

  @@index([userId])
  @@map("spin_claims")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model InstructorProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  professionalHeadline String?
  bio                  String?            @db.Text
  avatarUrl            String?
  coverImageUrl        String?
