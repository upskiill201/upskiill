// Monthly Quest — one row per user per local month. Progress = goal-days:
// a day counts when UserDailyActivity.xpEarned >= dailyGoalXp AND at least
// one lesson was completed that day. goalSnapshot is append-only so a day
// stays counted even if the user changes their dailyGoalXp tier mid-month.
model UserMonthlyQuest {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey           String   // 'YYYY-MM' local timezone
  status             String   @default("ACTIVE") // 'ACTIVE' | 'COMPLETED' | 'FULLY_CLAIMED'
  dailyGoalXpAtStart Int // dailyGoalXp snapshot at creation (informational)
  targetDays         Int // required goal-days for 100% — fixed at creation (prorated for mid-month joiners)
  goalDays           Int      @default(0) // denormalized count of goalSnapshot entries
  goalSnapshot       Json     @default("[]") // append-only [{ date, xpEarned, dailyGoalXp }]
  milestonesClaimed  Json     @default("[]") // e.g. ["M1", "M2"]; 'FINAL' appended on final claim
  finalRewardType    String? // written at final claim — mirrors WeeklySpin.rewardSnapshotType
  finalRewardAmount  Int?
  badgeId            String? // e.g. 'monthly_quest_2026_08' — future badge gallery reads this
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, monthKey])
  @@index([userId])
  @@map("user_monthly_quests")
}

// ─────────────────────────────────────────────────────────────────────────────
// CREATOR EARNINGS — immutable ledger, revenue-share agreements, payouts.
// Money rules: every amount is an INTEGER in minor units (cents). The only
// float→int boundary is Math.round(x * 100) at the payment-service call
// sites. Ledger rows are append-only (enforced by a DB trigger); all
// corrections are NEW rows that reference the original via
// relatedTransactionId. No FK relations on ledger tables by design — they
// must survive user/course deletion (GemTransaction precedent).
// ─────────────────────────────────────────────────────────────────────────────

enum CreatorTier {
  STANDARD
  FOUNDING
}

enum EarningsEntryType {
  SALE // first paid grant for a (student, course)
  RENEWAL // subsequent period on an already-ACTIVE entitlement
  REFUND // negative entry, proportional, matched to the original sale
  CHARGEBACK // negative entry when a dispute opens
  REVERSAL // positive entry restoring a won dispute
  ADJUSTMENT // manual admin correction (either sign), reason mandatory
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum PayoutMethodType {
  BANK
  MOBILE_MONEY
}

/// One revenue-share agreement per period. Active = effectiveUntil NULL.
/// New agreements close the previous row — history is never rewritten.
model CreatorEarningsAgreement {
  id              String      @id @default(uuid())
  userId          String
  tier            CreatorTier @default(STANDARD)
  creatorSharePct Int // 70 | 80 — percent of netMinor
  isFounding      Boolean     @default(false)
  effectiveFrom   DateTime    @default(now())
  effectiveUntil  DateTime?
  notes           String?
  createdBy       String? // admin userId when set manually
  createdAt       DateTime    @default(now())

  @@index([userId, effectiveUntil])
  @@map("creator_earnings_agreements")
}

/// Append-only earnings ledger. creatorSharePct is SNAPSHOTTED per row so a
/// later tier change never rewrites history. Signed amounts: credits > 0,
/// debits < 0. teyroAmountMinor = netMinor − creatorAmountMinor always.
model EarningsTransaction {
  id                   String            @id @default(uuid())
  publicId             String            @unique // "ET-XXXXXXXX" support reference
  creatorId            String
  courseId             String?
  studentId            String?
  orderId              String?

  type                 EarningsEntryType
  grossMinor           Int
  discountMinor        Int               @default(0)
  feeMinor             Int               @default(0) // processing fee; 0 until fee capture exists
  netMinor             Int // gross − discount − fee
  currency             String            @default("USD") // ledger currency (USD-only v1)
  nativeCurrency       String? // e.g. XAF — reference only, never summed
  nativeAmountMinor    Int?

  creatorSharePct      Int
  creatorAmountMinor   Int // signed
  teyroAmountMinor     Int // signed

  provider             String // STRIPE | MESOMB | MANUAL
  providerReference    String? // pi_/in_/cs_/re_/dp_/pk ids — dedupe key
  relatedTransactionId String? // reversal entries → original row
  reason               String? // MANDATORY for REFUND / CHARGEBACK / ADJUSTMENT
  occurredAt           DateTime          @default(now()) // drives the clearing window
  metadata             Json?

  createdAt            DateTime          @default(now()) // intentionally NO @updatedAt

  @@unique([provider, type, providerReference])
  @@index([creatorId, occurredAt])
  @@index([creatorId, type])
  @@index([courseId])
  @@index([orderId])
  @@index([providerReference])
  @@map("earnings_transactions")
}

/// Where creators get paid. FULL account details are AES-256-GCM encrypted
/// at rest; only masked display data is ever returned by APIs.
model CreatorPayoutMethod {
  id                String          @id @default(uuid())
  userId            String          @unique
  type              PayoutMethodType
  encryptedData     String // "v1:<keyVersion>:<iv>:<tag>:<cipher>"
  keyVersion        Int             @default(1) // supports future key rotation
  holderName        String?
  maskedDisplay     String? // "Bank Acct **4821"
  bankName          String? // display-only metadata
  country           String?
  receivingCurrency String?
  isVerified        Boolean         @default(false)
  verifiedAt        DateTime?
  eligibilityNote   String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("creator_payout_methods")
}

/// Payout requests. Funds are RESERVED from available balance while status
/// is REQUESTED / UNDER_REVIEW / PROCESSING. externalReference is the
/// drop-in slot for an automated rail (Stripe Connect transfer id).
model CreatorPayout {
  id                String       @id @default(uuid())
  publicId          String       @unique
  userId            String
  amountMinor       Int
  currency          String       @default("USD")
  status            PayoutStatus @default(REQUESTED)
  methodSnapshot    Json? // frozen masked method at request time
  requestedAt       DateTime     @default(now())
  reviewedAt        DateTime?
  processedAt       DateTime?
  paidAt            DateTime?
  closedAt          DateTime? // any terminal transition
  reviewedBy        String? // admin userId
  rejectionReason   String? // mandatory on REJECTED
  failureReason     String? // mandatory on FAILED
  cancelReason      String? // mandatory on CANCELLED
  adminNote         String?
  externalReference String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, requestedAt(sort: Desc)])
  @@index([status, requestedAt(sort: Desc)])
  @@map("creator_payouts")
}

/// Audit trail for every earnings mutation: agreement changes, payout state
/// transitions, adjustments, refund matching failures, method updates.
model EarningsAuditLog {
  id         String   @id @default(uuid())
  actorId    String? // null = system/webhook
  actorType  String   @default("SYSTEM") // ADMIN | CREATOR | SYSTEM
  action     String
  entityType String // EarningsTransaction | CreatorPayout | Agreement | PayoutMethod
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("earnings_audit_logs")
}


// ─────────────────────────────────────────────────────────────────────────────
// Tey Intelligence layer — activity events + learner state projection.
//
// Deliberately NOT reusing LearningEvent: that table is read by creator
// analytics (analytics.service.ts, students.service.ts) and requires non-null
// entityType/entityId, which app_opened / daily_goal_missed cannot supply.
// Mixing client telemetry into it would bloat its [userId, createdAt] index
// and risk semantic drift in creator dashboards.
// ─────────────────────────────────────────────────────────────────────────────

model TeyActivityEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// See TEY_EVENT_TYPES in tey/contracts/tey-event.types.ts for the closed union.
  eventType String
  /// 'SERVER' | 'CLIENT' — server-observed events are authoritative.
  source     String  @default("SERVER")
  entityType String?
  entityId   String?
  props      Json?

  /// Client-supplied, stable across retries. Unique WHERE NOT NULL (partial
  /// index lives in SQL only — Prisma cannot express it).
  idempotencyKey String?

  /// When it actually happened. Clamped server-side to [receivedAt-7d, receivedAt]
  /// so a skewed client clock can't pin a row to the top of the index forever.
  occurredAt DateTime
  receivedAt DateTime @default(now())
  /// YYYY-MM-DD in the learner's own zone at the time of the event.
  localDate  String

  @@index([userId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("tey_activity_events")
}

/// A CACHE, not a source of truth. Every column here is reproducible from
/// StudentProfile + UserDailyActivity + StreakService. It exists so the
/// decision engine and scheduler can read one indexed row instead of running
/// streak reconciliation for every due action.
model LearnerState {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Mirrored from StreakService.getStreakStats() — NEVER recomputed here.
  streakDays         Int       @default(0)
  longestStreak      Int       @default(0)
  lastStreakEarnedAt DateTime?
  freezesAvailable   Int       @default(0)

  // Today, in the learner's local calendar.
  localDate          String?
  todayXp            Int     @default(0)
  todayLessons       Int     @default(0)
  dailyGoalXp        Int     @default(20)
  todayGoalCompleted Boolean @default(false)

  // This week (Monday-anchored, matching UserWeeklyProgress).
  weeklyLessons Int @default(0)
  weeklyXp      Int @default(0)

  // Derived states — closed unions in tey/contracts/tey-state.types.ts.
  streakState      String @default("NO_STREAK")
  engagementState  String @default("NEW")
  courseState      String @default("NEW")
  performanceState String @default("STABLE")

  // Where to send them back to (resolved at projection time).
  currentCourseId     String?
  currentSectionIndex Int?
  currentLessonId     String?
  courseProgressPct   Int     @default(0)

  // Habit model: EWMA of the local hour at which lessons get completed.
  usualHourLocal   Int?
  usualHourSamples Int  @default(0)

  lastActivityAt DateTime?
  /// Consecutive nudges sent without an open — drives tone escalation.
  consecutiveIgnoredNudges Int @default(0)

  computedAt DateTime @default(now())
  revision   Int      @default(0)

  @@index([engagementState, lastActivityAt])
  @@index([streakState])
  @@map("learner_state")
}
