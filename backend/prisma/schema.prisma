generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String
  password    String
  role        Role      @default(STUDENT)
  avatarUrl   String?
  isVerified  Boolean   @default(false)
  verifyToken String?   @unique
  tokenExpiry DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // WhatsApp verification (set on onboarding Step 6)
  whatsappPhone    String?  // E.164 format, e.g. +2347012345678
  whatsappVerified Boolean  @default(false)

  // Dual-role access flags — the canonical source of truth for which profiles exist
  hasStudentAccess Boolean @default(false)
  hasCreatorAccess Boolean @default(false)

  profile             Profile?
  studentProfile      StudentProfile?
  instructorProfile   InstructorProfile?
  enrollments         Enrollment[]
  courses             Course[]                @relation("InstructorCourses")
  orders              Order[]
  reviews             Review[]
  onboardingDraft     CreatorOnboardingDraft?
  PasswordResetToken  PasswordResetToken[]
  onboardingSession   OnboardingSession?
  accessEntitlements  CourseAccessEntitlement[]
  courseSubscriptions CourseSubscription[]

  // Social Connections — Followers & Following
  following UserFollow[] @relation("UserFollower")
  followers UserFollow[] @relation("UserFollowing")

  // Account Security, Status & Lifecycle fields (Part 3A.2.1.2.1)
  accountStatus        AccountStatus @default(ACTIVE)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  lastActiveAt         DateTime?
  loginCount           Int           @default(0)
  failedLoginAttempts  Int           @default(0)
  accountLockedUntil   DateTime?
  deletedAt            DateTime?

  gemTransactions    GemTransaction[]
  shopTransactions   ShopTransaction[]
  userAchievements   UserAchievement[]
  userMissions       UserMission[]
  dailyMissions      UserDailyMission[]
  dailyMissionSets   DailyMissionSet[]
  rewardTransactions RewardTransaction[]
  spinClaims         SpinClaim[]
  courseProgresses   UserCourseProgress[]
  lessonProgresses   UserLessonProgress[]
  stepProgresses     UserStepProgress[]
  stepAttempts       UserStepAttempt[]
  learningSessions   LearningSession[]
  userLearningStreak UserLearningStreak?
  userStats          UserStats?
  weeklyProgresses   UserWeeklyProgress[]
  weeklySpins        WeeklySpin[]
  learningEvents     LearningEvent[]
  userInventories    UserInventory[]
  dailyChests        DailyChest[]
  dailyActivities    UserDailyActivity[]
  userMomentum       UserMomentum?
  rewardLogs             RewardLog[]
  xpEvents               XpEvent[]
  communityMemberships   CommunityMembership[]
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  activityFeed           ActivityFeed[]
  viewerFriendActivities FriendActivity[]       @relation("ViewerFriendActivities")
  actorFriendActivities  FriendActivity[]       @relation("ActorFriendActivities")
  notifications          Notification[]

  @@index([accountStatus, role])
  @@index([createdAt, role])
  @@index([lastLoginAt])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  LOCKED
  DELETED
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username             String?   @unique
  creatorStatus        String    @default("founding_creator")
  headline             String?
  bio                  String?   @db.Text
  about                String?   @db.Text
  avatarUrl            String?
  coverImageUrl        String?
  introVideoUrl        String?
  tagline              String?
  location             String?
  languages            Json?
  primaryExpertise     String?
  skills               Json?
  teachingLevels       Json?
  contentFormats       Json?

  // Experience, Education & Certifications
  experiences          Json?
  education            Json?
  certifications       Json?

  // Social & Professional Links
  website              String?
  linkedin             String?
  github               String?
  twitter              String?
  youtube              String?
  instagram            String?
  tiktok               String?
  facebook             String?
  portfolio            String?

  // Contact & Preferences
  contactMethod        String?   @default("email")
  businessEmail        String?
  allowCollaboration   Boolean   @default(true)
  profileVisibility    String    @default("PUBLIC")
  privacySettings      Json?

  usernameLastChangedAt DateTime?

  // Creator profile fields (hydrated from onboarding answers)
  niche            String? // Step 3: primary teaching category
  subCategories    Json? // Step 3: all selected categories
  audienceSize     String? // Step 4: audience scale
  platforms        Json? // Step 5: current platforms
  weeklyHours      String? // Step 9: available time per week
  biggestChallenge String? // Step 7: primary pain point
  teachingStyle    String? // Step 8: content/teaching approach
  launchGoal       String? // Step 12: first course launch goal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id               String  @id @default(uuid())
  title            String
  slug             String  @unique
  description      String  @db.Text
  shortDescription String?
  thumbnailUrl     String?
  price            Float
  originalPrice    Float?
  published        Boolean @default(false)

  // Teyro Course Transformation Engine
  category          String  @default("Uncategorized")
  level             String  @default("Beginner")
  duration          String  @default("0h")
  creatorTimeWeekly String?
  subtitle          String?
  startingPoint     String? @db.Text
  endOutcome        String? @db.Text
  realOutputs       Json?

  subcategory  String?
  language     String  @default("English")
  skills       Json? // Array of strings
  requirements Json? // Array of strings (Prerequisites)
  outcomes     Json? // Array of strings (What learners will achieve)

  rating        Float @default(0)
  reviewsCount  Int   @default(0)
  studentsCount Int   @default(0)

  curriculum Json? @default("[]")

  // Relations
  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])

  sections Section[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments          Enrollment[]
  accessEntitlements   CourseAccessEntitlement[]
  courseSubscriptions  CourseSubscription[]
  orderItems           OrderItem[]
  userCourseProgresses UserCourseProgress[]
  community            Community?
  posts                Post[]
}

model Section {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  goal        String?  @db.Text
  orderIndex  Int      @default(0)
  isLocked    Boolean  @default(false)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id               String  @id @default(uuid())
  title            String  @db.VarChar(100)
  description      String? @db.Text
  shortDescription String? @db.VarChar(300)
  lessonType       String  @default("video")
  orderIndex       Int     @default(0)
  isFreePreview    Boolean @default(false)
  durationMinutes  Int     @default(0)

  // Status and versioning for optimistic locking and draft support
  status                   String    @default("draft") // draft, published, scheduled, archived
  version                  Int       @default(1)
  publishedAt              DateTime?
  estimatedDurationSeconds Int       @default(0)

  // Block-based content architecture
  contentBlocks Json? @default("{}")

  // Phase completion state tracking
  stepCompletion Json? @default("{\"learn\":false,\"apply\":false,\"reflect\":false,\"deepen\":false}")

  // System
  xpReward Int @default(10)

  // Relations
  sectionId String
  section   Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  steps     LessonStep[]
  userLessonProgresses UserLessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("course_lessons")
}

model LessonStep {
  id              String   @id @default(uuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  stepType        String   // 'learn' | 'apply' | 'reflect' | 'resources'
  title           String?
  orderIndex      Int      @default(0)
  isRequired      Boolean  @default(true)
  unlockCondition Json?

  contents         LessonStepContent[]
  userStepProgresses UserStepProgress[]
  userStepAttempts   UserStepAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([stepType])
  @@map("lesson_steps")
}

model LessonStepContent {
  id            String     @id @default(uuid())
  stepId        String
  step          LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  contentType   String     // 'video' | 'text' | 'quiz' | 'task' | 'ai_prompt' | 'file'
  content       Json
  orderIndex    Int        @default(0)
  isInteractive Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId])
  @@map("lesson_step_content")
}

model LessonResource {
  id               String  @id @default(uuid())
  lessonId         String
  lesson           Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type             String // pdf, pptx, fig, link, video
  title            String
  storageUrl       String
  sizeBytes        Int?
  originalName     String?
  estimatedReadMin Int     @default(0)
  displayOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id       String  @id @default(uuid())
  rating   Int // 1 to 5
  comment  String? @db.Text
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId]) // One review per user per course
}

model Enrollment {
  id               String   @id @default(uuid())
  userId           String
  courseId         String
  progress         Int      @default(0)
  completedLessons Json?    @default("[]")
  createdAt        DateTime @default(now())
  course           Course   @relation(fields: [courseId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

enum AccessPlan {
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
}

enum AccessStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model CourseAccessEntitlement {
  id                   String       @id @default(uuid())
  userId               String
  courseId             String
  plan                 AccessPlan   @default(MONTHLY)
  status               AccessStatus @default(ACTIVE)
  startDate            DateTime     @default(now())
  expiresAt            DateTime
  cancelAtPeriodEnd    Boolean      @default(false)
  stripeSubscriptionId String?
  stripeCustomerId     String?
  pricePaid            Float?

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([userId, courseId])
  @@index([userId, courseId, status, expiresAt])
  @@map("course_access_entitlements")
}

enum PaymentProviderType {
  STRIPE
  MESOMB
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model CourseSubscription {
  id                     String              @id @default(uuid())
  userId                 String
  courseId               String
  provider               PaymentProviderType @default(STRIPE)
  providerSubscriptionId String?
  providerCustomerId     String?
  plan                   AccessPlan          @default(MONTHLY)
  status                 SubscriptionStatus  @default(ACTIVE)
  startedAt              DateTime            @default(now())
  currentPeriodStart     DateTime            @default(now())
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  endedAt                DateTime?
  autoRenew              Boolean             @default(true)
  pricePaid              Float?
  currency               String              @default("USD")

  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                 Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([userId, courseId, status])
  @@index([provider, providerSubscriptionId])
  @@map("course_subscriptions")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  price     Float // Price at the time of purchase
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model Waitlist {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  name              String?
  email             String?
  phone             String?
  discovery_channel String?
  role              String?
  raw_data          Json?
}

model CreatorOnboardingDraft {
  id        String   @id @default(uuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}") // Stores answers from steps 1-13
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model OnboardingSession {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStep    Int       @default(1)
  completedSteps Int[]     @default([])
  answers        Json      @default("{}")
  onboardingComplete Boolean @default(false)
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@map("onboarding_sessions")
}

model StudentProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Learning progress data
  xp                 Int       @default(30) // 30 XP starter grant
  streakDays         Int       @default(0)
  lastActiveAt       DateTime?
  lastStreakEarnedAt DateTime? // Exact timestamp when daily streak was last incremented

  // Lives system — lose a life on wrong Apply answer, refill 1 per 4h
  lives           Int       @default(5)
  maxLives        Int       @default(5)
  livesLastLostAt DateTime?  // timestamp of when the last life was lost

  // Streak freezes (banked freezes)
  streakFreezeBank Int       @default(1)

  // Daily quests log
  completedQuests  Json      @default("[]")
  lastQuestResetAt DateTime?

  // Achievements log — tracks which badge levels have been unlocked and claimed
  // Format: [{ badgeId, level, claimed, unlockedAt }]
  achievements Json @default("[]")

  // Daily Reward (Login Chest)
  lastRewardClaimedAt      DateTime?
  dailyRewardCyclePosition Int       @default(1)

  // Gems & Coins currency & longest streak tracking
  gems                  Int       @default(100) // 100 Gems starter grant
  coins                 Int       @default(50)  // 50 Coins starter grant
  longestStreak         Int       @default(3)
  lastLessonCompletedAt DateTime? // Exact timestamp when a lesson was finished

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("student_profiles")
}

model GemTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'EARN' | 'SPEND'
  amount    Int
  source    String   // 'LESSON' | 'DAILY_GOAL' | 'LEARNING_PATH' | 'LEVEL_UP' | 'PERFECT_LESSON' | 'SHOP' | 'CHALLENGE' | 'ADMIN'
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("gem_transactions")
}

model ShopTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      String   // 'REFILL_HEARTS' | 'STREAK_FREEZE'
  quantity  Int      @default(1)
  cost      Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("shop_transactions")
}

model WhatsappAuthStore {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("whatsapp_auth_store")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String   // 'wildfire' | 'sage' | 'champion' | 'explorer' | 'marathon'
  tier          Int      @default(1)
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId, tier])
  @@index([userId])
  @@map("user_achievements")
}

model UserMission {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionKey String    // 'COMPLETE_LESSON' | 'MAINTAIN_STREAK' | 'LEARN_MINUTES'
  progress   Int       @default(0)
  target     Int       @default(1)
  completed  Boolean   @default(false)
  claimedAt  DateTime?
  dateStr    String    // YYYY-MM-DD local date string

  @@unique([userId, missionKey, dateStr])
  @@index([userId, dateStr])
  @@map("user_missions")
}

model SpinClaim {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType String   // 'COINS' | 'XP' | 'FREEZE' | 'HEARTS'
  rewardVal  Int
  claimedAt  DateTime @default(now())

  @@index([userId])
  @@map("spin_claims")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model InstructorProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  professionalHeadline String?
  bio                  String?            @db.Text
  avatarUrl            String?
  coverImageUrl        String?
  websiteUrl           String?
  linkedinUrl          String?
  youtubeUrl           String?
  verificationStatus   VerificationStatus @default(PENDING)
  profileVisibility    ProfileVisibility  @default(PUBLIC)
  yearsOfExperience    Int?
  expertise            Json?              @default("[]")
  onboardingCompleted  Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([verificationStatus, profileVisibility])
  @@index([displayName, verificationStatus])
  @@map("instructor_profiles")
}

model UserCourseProgress {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status             String    @default("not_started") // not_started, in_progress, completed, paused
  progressPercentage Float     @default(0)
  currentLessonId    String?
  lastStepId         String?
  startedAt          DateTime?
  completedAt        DateTime?
  lastActiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@map("user_course_progress")
}

model UserLessonProgress {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status             String    @default("locked") // locked, unlocked, in_progress, completed
  progressPercentage Float     @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  timeSpentSeconds   Int       @default(0)
  attemptsCount      Int       @default(0)
  lastStepId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_lesson_progress")
}

model UserStepProgress {
  id                   String     @id @default(uuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId               String
  step                 LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status               String     @default("not_started") // not_started, in_progress, completed, failed
  completionPercentage Float      @default(0)
  score                Float?
  attemptsCount        Int        @default(0)
  timeSpentSeconds     Int        @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  lastAttemptAt        DateTime?
  isMastered           Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stepId])
  @@index([userId])
  @@map("user_step_progress")
}

model UserStepAttempt {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId           String
  step             LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  attemptNumber    Int        @default(1)
  inputData        Json?
  resultScore      Float?
  aiFeedback       String?    @db.Text
  isCorrect        Boolean?
  timeSpentSeconds Int?

  createdAt DateTime @default(now())

  @@index([stepId])
  @@index([userId])
  @@map("user_step_attempts")
}

model LearningSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  durationSeconds  Int?
  lessonsCompleted Int       @default(0)
  stepsCompleted   Int       @default(0)
  deviceType       String?   // 'mobile' | 'desktop'

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("learning_sessions")
}

model UserLearningStreak {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActivityDate  String?  // YYYY-MM-DD
  streakFreezeCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastActivityDate])
  @@map("user_learning_streaks")
}

model UserStats {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp          Int       @default(0)
  totalCoins       Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lessonsCompleted Int       @default(0)
  lastActivityAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_stats")
}

model UserWeeklyProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate    String   // YYYY-MM-DD (Monday)
  lessonsCompleted Int      @default(0)
  xpEarned         Int      @default(0)
  daysActive       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("user_weekly_progress")
}

model LearningEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String   // 'LESSON_COMPLETED' | 'STREAK_INCREMENTED' | 'ACHIEVEMENT_UNLOCKED'
  entityType String   // 'lesson' | 'course' | 'achievement'
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("learning_events")
}

model UserInventory {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType    String    // 'FREEZE' | 'BOOST' | 'CHEST'
  quantity    Int       @default(0)
  activeUntil DateTime? // For duration-based items like XP_BOOST
  updatedAt   DateTime  @updatedAt

  @@unique([userId, itemType])
  @@index([userId])
  @@map("user_inventory")
}

model ChestRewardPool {
  id          String   @id @default(uuid())
  rewardType  String   // 'COINS' | 'GEMS' | 'HEARTS' | 'XP_BOOST' | 'STREAK_FREEZE'
  amountMin   Int?
  amountMax   Int?
  rarityTier  String   // 'common' | 'uncommon' | 'rare'
  weight      Int
  active      Boolean  @default(true)

  dailyChests DailyChest[]

  @@map("chest_reward_pool")
}

model DailyChest {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chestDay             String            // YYYY-MM-DD in user's timezone
  status               String            @default("LOCKED") // 'LOCKED' | 'READY_TO_OPEN' | 'OPENED'
  unlockedAt           DateTime?
  openedAt             DateTime?
  rewardPoolId         String?
  rewardPool           ChestRewardPool?  @relation(fields: [rewardPoolId], references: [id])
  rewardSnapshotType   String?
  rewardSnapshotAmount Int?
  createdAt            DateTime          @default(now())

  @@unique([userId, chestDay])
  @@index([userId])
  @@map("daily_chests")
}

model UserDailyActivity {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // YYYY-MM-DD
  lessonsCompleted Int      @default(0)
  xpEarned         Int      @default(0)
  timeSpentSeconds Int      @default(0)
  streakExtended   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_daily_activity")
}

model UserMomentum {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  momentumScore    Int      @default(0)
  lastCalculatedAt DateTime @default(now())

  @@map("user_momentum")
}

model RewardLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType  String   // 'XP' | 'COINS' | 'FREEZE' | 'HEARTS' | 'SPIN'
  rewardValue Int
  sourceType  String   // 'MISSION' | 'CHEST' | 'SPIN' | 'STREAK' | 'LESSON'
  sourceId    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("reward_logs")
}

model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String   // 'LESSON' | 'MISSION' | 'REWARD' | 'CHALLENGE'
  sourceId   String?
  xpAmount   Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("xp_events")
}

model Community {
  id          String   @id @default(uuid())
  name        String
  courseId    String?  @unique
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  description String?  @db.Text
  visibility  String   @default("PUBLIC") // 'PUBLIC' | 'PRIVATE'
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  memberships CommunityMembership[]
  posts       Post[]

  @@map("communities")
}

model CommunityMembership {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // 'MEMBER' | 'ADMIN'
  joinedAt    DateTime  @default(now())

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("community_memberships")
}

model Post {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId  String?
  community    Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  postType     String     @default("PROGRESS") // 'PROGRESS' | 'QUESTION' | 'ACHIEVEMENT'
  contentText  String     @db.Text
  mediaUrl     String?
  likeCount    Int        @default(0)
  commentCount Int        @default(0)
  createdAt    DateTime   @default(now())

  comments Comment[]

  @@index([userId])
  @@index([communityId])
  @@index([courseId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentText String   @db.Text
  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model Like {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String   // 'POST' | 'COMMENT'
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("likes")
}

model ActivityFeed {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String   // 'LESSON_COMPLETED' | 'STREAK' | 'LEVEL_UP'
  entityType   String   // 'lesson' | 'streak' | 'level'
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  friendActivities FriendActivity[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_feed")
}

model FriendActivity {
  id           String       @id @default(uuid())
  userId       String       // Viewer
  user         User         @relation("ViewerFriendActivities", fields: [userId], references: [id], onDelete: Cascade)
  friendUserId String       // Actor
  friendUser   User         @relation("ActorFriendActivities", fields: [friendUserId], references: [id], onDelete: Cascade)
  activityId   String
  activity     ActivityFeed @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([friendUserId])
  @@map("friend_activity")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // 'LIKE' | 'COMMENT' | 'FRIEND_ACTIVITY' | 'SYSTEM'
  entityType String?
  entityId   String?
  title      String?
  body       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model MissionTemplate {
  id                  String   @id @default(uuid())
  code                String   @unique
  title               String
  description         String?  @db.Text
  icon                String?
  objectiveType       String   // 'LESSON_COUNT', 'XP_EARNED', 'STREAK_ACTIVE', etc.
  defaultTarget       Int
  defaultRewardType   String   // 'XP', 'COINS', 'GEMS'
  defaultRewardAmount Int
  difficultyTier      String   @default("medium") // 'easy', 'medium', 'hard'
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  userMissions UserDailyMission[]

  @@map("mission_templates")
}

model DailyMissionSet {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionDay  String   // YYYY-MM-DD local timezone
  generatedAt DateTime @default(now())
  resetAt     DateTime

  missions UserDailyMission[]

  @@unique([userId, missionDay])
  @@index([userId, missionDay])
  @@map("daily_mission_sets")
}

model UserDailyMission {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMissionSetId String?
  dailyMissionSet   DailyMissionSet? @relation(fields: [dailyMissionSetId], references: [id], onDelete: Cascade)
  templateId        String
  template          MissionTemplate  @relation(fields: [templateId], references: [id])
  missionDate       String           // YYYY-MM-DD
  title             String
  objectiveType     String           // 'LESSON_COUNT', 'XP_EARNED', 'STREAK_ACTIVE'
  currentProgress   Int              @default(0)
  targetValue       Int
  rewardType        String           // 'XP', 'COINS', 'GEMS'
  rewardAmount      Int
  status            String           @default("IN_PROGRESS") // 'IN_PROGRESS', 'COMPLETED', 'CLAIMED', 'EXPIRED'
  isCompleted       Boolean          @default(false)
  isClaimed         Boolean          @default(false)
  completedAt       DateTime?
  claimedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@unique([userId, templateId, missionDate])
  @@index([userId, missionDate])
  @@map("user_daily_missions")
}

model RewardTransaction {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency       String   // 'XP', 'COINS', 'GEMS', 'HEARTS'
  amount         Int
  sourceType     String   // 'MISSION_CLAIM', 'MYSTERY_CHEST', 'LUCKY_SPIN', etc.
  sourceId       String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("reward_transactions")
}

model SpinWheelSegment {
  id           String  @id @default(uuid())
  segmentIndex Int
  rewardType   String  // 'COINS', 'XP', 'HEARTS', 'STREAK_FREEZE'
  amountMin    Int
  amountMax    Int
  rarityTier   String  // 'common', 'uncommon', 'rare'
  weight       Int
  colorKey     String
  active       Boolean @default(true)

  @@map("spin_wheel_segments")
}

model WeeklySpin {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart            String    // YYYY-MM-DD (Monday) local timezone
  status               String    @default("AVAILABLE") // 'AVAILABLE' | 'SPUN'
  spunAt               DateTime?
  landedSegmentIndex   Int?
  rewardSnapshotType   String?
  rewardSnapshotAmount Int?

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("weekly_spins")
}

