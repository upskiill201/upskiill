  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  postType     String     @default("PROGRESS") // 'PROGRESS' | 'QUESTION' | 'ACHIEVEMENT' | 'GENERAL' | 'MILESTONE' | 'TIP' | 'WIN' | 'RESOURCE' | 'DISCUSSION' | 'POLL' | 'ANNOUNCEMENT' | 'CHALLENGE'
  title        String?    // optional headline (150 chars max, enforced in DTOs)
  contentText  String     @db.Text
  mediaUrl     String?
  images       String[]   // ordered image URLs uploaded direct-to-S3
  lessonId     String? // lesson-linked discussions ("Discuss this lesson")
  lesson       Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  isPinned     Boolean    @default(false) // Commons moderation — pinned posts float to top of feed page 1
  isLocked     Boolean    @default(false) // creator locked comments
  status       String     @default("ACTIVE") // 'ACTIVE' | 'REMOVED' (moderation soft-delete)
  likeCount    Int        @default(0)
  commentCount Int        @default(0)
  viewCount    Int        @default(0)
  lastActivityAt DateTime @default(now()) // bumped on comment; drives feed recency
  editedAt     DateTime?
  createdAt    DateTime   @default(now())

  comments    Comment[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  attachments PostAttachment[]

  @@index([userId])
  @@index([communityId])
  @@index([courseId])
  @@index([lessonId])
  @@index([createdAt(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@map("posts")
