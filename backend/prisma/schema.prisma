/// Per-course weekly XP ledger for The Arena (course-scoped leaderboard).
/// One row per (user, course, UTC week) — written by ArenaService on lesson
/// completion. Weeks are fixed UTC Mondays so everyone on a course shares one
/// board (deliberately different from UserWeeklyProgress, which is user-local).
/// `divisionId` is reserved for future Bronze→Diamond-style split boards.
model CourseWeeklyXp {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId       String?
  weekStartDate    String   // YYYY-MM-DD, always a Monday in UTC
  xpEarned         Int      @default(0)
  lessonsCompleted Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, weekStartDate])
  @@index([courseId, weekStartDate, xpEarned(sort: Desc)])
  @@map("course_weekly_xp")
}

// Weekly league ladder for the global Duolingo-style leaderboard.
// Order matters — settlement promotes/demotes by index.
enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  RUBY
  EMERALD
  AMETHYST
  PEARL
  DIAMOND
  DIAMOND_TOURNAMENT
}

/// One weekly competition group of up to 30 users within a league tier.
/// Tournament cohorts are rows with league = DIAMOND_TOURNAMENT. Weeks are
/// fixed UTC Mondays so every user shares one clock (like CourseWeeklyXp).
model LeagueCohort {
  id          String    @id @default(uuid())
  league      LeagueTier
  weekStart   String    // YYYY-MM-DD, always a Monday in UTC
  cohortIndex Int       // sequential within (league, weekStart)
  status      String    @default("ACTIVE") // 'ACTIVE' | 'SETTLED'
  settledAt   DateTime?
  members     LeagueMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([league, weekStart, cohortIndex])
  @@index([weekStart])
  @@map("league_cohorts")
}

/// One user's standing in one league week. `cohortId` is null for synthetic
/// inactivity-demotion rows (user was in a league but earned no XP that week).
/// `outcome` + `seenAt` drive the one-time settlement celebration scene.
model LeagueMember {
  id          String        @id @default(uuid())
  cohortId    String?
  cohort      LeagueCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   String        // YYYY-MM-DD Monday UTC (denormalized for unique + queries)
  league      LeagueTier    // tier the user competed in this week
  weeklyXp    Int           @default(0)
  xpUpdatedAt DateTime      @default(now()) // tie-break: earlier reach = higher rank
  joinedAt    DateTime      @default(now())
  rank        Int?
  outcome     String?       // 'PROMOTED' | 'DEMOTED' | 'STAYED' | 'CHAMPION' | 'TOURNAMENT_EXIT' | 'INACTIVE_DEMOTED'
  seenAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([cohortId, weeklyXp(sort: Desc)])
  @@index([userId, weekStart(sort: Desc)])
  @@map("league_members")
}

