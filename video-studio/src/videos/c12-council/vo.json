.692,"line":"i4","accent":true,"brk":false},{"w":"step.","s":29.726,"e":30.806,"line":"i4","accent":true,"brk":false},{"w":"One","s":30.172,"e":30.369,"line":"s1","accent":false,"brk":false},{"w":"AI","s":30.404,"e":30.66,"line":"s1","accent":false,"brk":false},{"w":"will","s":30.718,"e":30.834,"line":"s1","accent":false,"brk":false},{"w":"always","s":30.88,"e":31.136,"line":"s1","accent":false,"brk":false},{"w":"say","s":31.17,"e":31.31,"line":"s1","accent":false,"brk":false},{"w":"yes.","s":31.356,"e":31.791,"line":"s1","accent":true,"brk":false},{"w":"Eighteen","s":31.845,"e":32.263,"line":"s1","accent":true,"brk":true},{"w":"won't.","s":32.345,"e":33.239,"line":"s1","accent":false,"brk":false},{"w":"Comment","s":32.833,"e":33.123,"line":"c1","accent":false,"brk":false},{"w":"COUNCIL,","s":33.158,"e":33.599,"line":"c1","accent":true,"brk":false},{"w":"and","s":33.634,"e":33.75,"line":"c1","accent":false,"brk":true},{"w":"I'll","s":33.785,"e":33.901,"line":"c1","accent":false,"brk":false},{"w":"send","s":33.936,"e":34.064,"line":"c1","accent":false,"brk":false},{"w":"you","s":34.098,"e":34.168,"line":"c1","accent":false,"brk":false},{"w":"where","s":34.203,"e":34.342,"line":"c1","accent":false,"brk":false},{"w":"to","s":34.366,"e":34.412,"line":"c1","accent":false,"brk":false},{"w":"learn","s":34.447,"e":34.633,"line":"c1","accent":false,"brk":false},{"w":"AI","s":34.679,"e":34.865,"line":"c1","accent":true,"brk":false},{"w":"tools","s":34.923,"e":35.12,"line":"c1","accent":true,"brk":false},{"w":"like","s":35.155,"e":35.294,"line":"c1","accent":false,"brk":false},{"w":"this.","s":35.329,"e":35.944,"line":"c1","accent":false,"brk":false}],"lines":[{"id":"h1","start":0.12,"end":4.818,"text":"Claude says yes to every idea you have. So someone built eighteen great minds to tear it apart."},{"id":"i1a","start":4.918,"end":9.465,"text":"It's an open-source plugin called Council of High Intelligence, with over four thousand stars on GitHub."},{"id":"i1b","start":9.565,"end":14.602,"text":"Type slash council and your question, and it goes to a panel like Socrates, Feynman, and Charlie Munger."},{"id":"i2","start":14.702,"end":18.584,"text":"Each one makes up their mind blind first, so nobody just copies the loudest voice."},{"id":"i3","start":18.684,"end":25.305,"text":"Then they cross-examine each other. Socrates attacks your assumptions. Munger asks what would make it fail. Kahneman hunts for the bias you can't see."},{"id":"i4","start":25.405,"end":30.072,"text":"Then you get a verdict: what's still unresolved, where they split, the kill criteria, and one next step."},{"id":"s1","start":30.172,"end":32.733,"text":"One AI will always say yes. Eighteen won't."},{"id":"c1","start":32.833,"end":35.739,"text":"Comment COUNCIL, and I'll send you where to learn AI tools like this."}],"lip":{"amp":[0,0,0,0.001,0.002,0.266,0.624,0.99,1,0.861,0.676,0.659,0.38,0.644,0.78,0.816,1,1,0.758,0.704,0.783,1,1,0.892,0.764,0.484,0.565,0.268,0.738,1,0.714,0.036,0.004,0.18,0.762,0.758,0.835,0.43,1,1,1,1,0.854,0.886,1,0.884,0.669,1,1,1,1,0.969,0.954,1,1,0.786,1,1,0.904,0.856,0.758,0.813,1,0.646,0.405,0.33,0.166,0.005,0.006,0.004,0.43,0.761,1,1,1,0.902,0.937,1,0.824,0.877,0.795,1,1,1,1,1,0.908,1,1,1,0.591,0.486,0.158,0.459,1,0.948,0.698,0.111,0.518,0.796,0.862,1,1,1,1,0.822,1,1,1,0.608,0.223,1,1,1,0.987,0.859,0.927,1,1,1,0.95,0.684,0.124,0.656,0.397,0.129,0.826,1,1,0.978,0.989,0.76,0.839,0.215,0.092,0.722,1,0.985,0.956,1,0.86,0.055,0.114,0.054,0.005,0,0,0,0.001,0.024,1,0.17,0.931,1,1,1,0.667,1,1,0.437,0.107,0.99,0.909,0.936,0.842,0.588,1,1,1,0.675,0.507,0.026,0.066,0.444,1,0.94,0.455,0.667,1,0.945,0.821,1,1,0.498,0.698,1,1,0.799,0.242,0.063,0.365,0.722,1,1,0.795,0.952,0.523,0.862,0.941,0.982,1,1,0.321,0.438,0.741,1,1,0.894,0.92,0.998,0.834,0.908,0.626,0.477,1,1,1,1,0.292,0.735,0.871,0.706,0.532,0.593,0.364,1,0.822,0.69,0.309,0.006,0.036,0.018,0.551,1,0.298,1,0.628,0.275,0.825,0.76,0.38,0.259,0.334,1,1,1,0.823,0.038,0.741,0.817,0.968,0.898,0.724,0.584,1