1.794,"e":32.144,"line":"c1","accent":false,"brk":false},{"w":"Go","s":32.186,"e":32.302,"line":"c1","accent":false,"brk":true},{"w":"to","s":32.348,"e":32.406,"line":"c1","accent":false,"brk":false},{"w":"teyro","s":32.476,"e":32.871,"line":"c1","accent":false,"brk":false},{"w":"dot","s":32.975,"e":33.184,"line":"c1","accent":false,"brk":false},{"w":"app","s":33.242,"e":33.509,"line":"c1","accent":false,"brk":false},{"w":"slash","s":33.579,"e":33.869,"line":"c1","accent":false,"brk":false},{"w":"teach.","s":33.915,"e":34.577,"line":"c1","accent":true,"brk":false}],"lines":[{"id":"h1","start":0.12,"end":3.139,"text":"Four things every coding course needs, so students actually finish."},{"id":"i1","start":3.239,"end":8.151,"text":"First, short lessons. When researchers compared online courses, the longer the course, the fewer people finished."},{"id":"i2","start":8.251,"end":13.492,"text":"Second, practice that's checked instantly. Testing yourself beats rereading, and feedback nearly doubles the benefit."},{"id":"i3","start":13.592,"end":18.133,"text":"Third, a moment to explain it back. Putting an idea in your own words shows what you actually understood."},{"id":"i4","start":18.233,"end":23.606,"text":"And finally, a reason to come back tomorrow. Habits come from showing up most days, so streaks and reminders matter."},{"id":"s1","start":23.706,"end":28.884,"text":"So in our Studio, every lesson runs in four steps: learn, apply, reflect, and deepen."},{"id":"c1","start":28.984,"end":34.341,"text":"If you teach coding or AI, you keep seventy percent of every payment. Go to teyro dot app slash teach."}],"lip":{"amp":[0,0,0,0.001,0.001,0.12,0.557,1,1,1,0.603,0.024,0.91,0.817,0.878,0.92,1,1,1,0.776,0.861,0.946,0.752,0.31,0.716,1,0.987,0.221,0.553,0.91,1,0.792,1,1,1,0.881,0.463,1,1,0.846,0.737,0.449,0.357,1,1,1,1,1,0.974,0.64,0.464,0.615,0.702,0.62,0.439,0.32,0.527,0.723,0.88,1,0.915,0.728,0.244,1,1,0.777,1,1,0.939,0.852,0.925,0.808,0.719,0.291,0.963,0.827,0.87,1,1,0.6