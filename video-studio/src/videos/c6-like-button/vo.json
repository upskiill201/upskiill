58,"e":43.221,"line":"c1","accent":false,"brk":false},{"w":"apps","s":43.267,"e":43.441,"line":"c1","accent":false,"brk":false},{"w":"that","s":43.476,"e":43.592,"line":"c1","accent":false,"brk":false},{"w":"feel","s":43.627,"e":43.766,"line":"c1","accent":false,"brk":false},{"w":"this","s":43.801,"e":43.929,"line":"c1","accent":false,"brk":false},{"w":"fast,","s":43.964,"e":44.44,"line":"c1","accent":false,"brk":false},{"w":"the","s":44.544,"e":44.649,"line":"c1","accent":false,"brk":true},{"w":"app","s":44.695,"e":44.834,"line":"c1","accent":false,"brk":false},{"w":"I","s":44.892,"e":44.916,"line":"c1","accent":false,"brk":false},{"w":"learn","s":44.974,"e":45.159,"line":"c1","accent":false,"brk":false},{"w":"on","s":45.218,"e":45.334,"line":"c1","accent":false,"brk":false},{"w":"is","s":45.38,"e":45.45,"line":"c1","accent":false,"brk":false},{"w":"in","s":45.496,"e":45.554,"line":"c1","accent":false,"brk":false},{"w":"my","s":45.601,"e":45.67,"line":"c1","accent":false,"brk":false},{"w":"bio.","s":45.728,"e":46.564,"line":"c1","accent":true,"brk":false},{"w":"It's","s":46.249,"e":46.446,"line":"c2","accent":false,"brk":false},{"w":"called","s":46.493,"e":46.783,"line":"c2","accent":false,"brk":false},{"w":"Teyro.","s":46.888,"e":47.689,"line":"c2","accent":true,"brk":false}],"lines":[{"id":"h1","start":0.12,"end":2.18,"text":"Don't trust that red heart. It's lying to you."},{"id":"h2","start":2.28,"end":4.744,"text":"Here's what really happens in the first second after you tap."},{"id":"i1","start":4.844,"end":9.417,"text":"First, at zero milliseconds, the heart turns red before your phone has even asked the server."},{"id":"i2","start":9.517,"end":14.955,"text":"Second, a tiny message leaves your phone, saying like this post, and travels to the server while you're already scrolling."},{"id":"i3","start":15.055,"end":19.966,"text":"Third, if that message fails, say you lose signal, the app quietly rolls it back, or tries again later."},{"id":"i4","start":20.066,"end":27.147,"text":"And finally, why? Research says a tenth of a second feels instant, and a trip to the server can take longer. So the app guesses you'll succeed."},{"id":"s1","start":27.247,"end":34.231,"text":"The full rule has three numbers. A tenth of a second feels instant, one second keeps your flow, and after ten seconds, people stop paying attention."},{"id":"n1","start":34.331,"end":39.03,"text":"It's called optimistic UI, and Meta's own developer docs use the Like button as the example."},{"id":"t1","start":39.13,"end":42.424,"text":"Try it. Turn on airplane mode, tap Like, and watch what your app does."},{"id":"c1","start":42.524,"end":46.149,"text":"If you want to build apps that feel this fast, the app I learn on is in my bio."},{"id":"c2","start":46.249,"end":47.495,"text":"It's called Teyro."}],"lip":{"amp":[0,0,0,0,0.001,0.149,0.952,0.794,0.503,0.646,1,0.736,1,1,0.767,0.643,0.232,0.904,0.955,0.905,0.378,0.593,1,1,0.818,0.763,0.984,1,1,1,0.959,0.877,0.391,0.155,0.119,0.015,0.003,0.001,0.574,0.799,0.32,0.852,0.707,1,1,1,1,1,1,1,1,0.998,0.787,0.664,1,0.869,0.994,1,0.993,0.939,0.952,0.834,0.858,0.386,0.012,0.004,0,0,0.001,0.026,0.723,1,1,0.909,0.756,0.252,1,0.797,0.432,0.729,1,1,1,1,1,1,0.968,1,0.99,0.689,0.025,0.85,1,1,1,0.747,0.952,0.914,1,1,0.604,0.221,0.313,0.759,0.83,0.911,0.629,0.63,0.549,0.512,0.672,0.396,0.026,0.11,1,0.929,0.908,1,1,0.741,0.616,0.69,0.647,0.519,0.164,0.539,1,0.958,0.996,0.999,0.332,0.415,0.677,1,0.713,0.668,0.455,0.399,0.033,0.114,0.09,0.031,0.004,0,0,0.001,0.384,0.785,0.97,0.883,1,0.899,0.842,0.739,0.809,0.69,0.041,0.815,0.502,0.039,0.001,0.001,0.009,0.729,0.971,0.839,0.189,0.737,1,1,1,1,1,1,1,0.974,1,1,1,0.983,1,0.77,0.775,0.544,0.832,0.685,0.108,0.276,0.882,0.636,0.456,0.414,0.712,0.924,0.845,0.864,0.834,0.693,0.074,0.005,0.003,0.001,0.757,0.75,0.56,0.857,1,1,1,0.533,0.054,0.694,0.487,1,1,1,1,0.902,0.857,0.645,1,1,1,1,1,0.726,0.679,0.564,1,0.583,0.407,1,1,1,1,1,1,0.674,0.396,0.224,0.674,1,1,1,1,1,1,1,1,1,0.829,0.781,1,1,0.845