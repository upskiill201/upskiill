":"that","s":42.811,"e":42.938,"line":"s1","accent":false,"brk":false},{"w":"takes","s":42.973,"e":43.182,"line":"s1","accent":false,"brk":false},{"w":"the","s":43.217,"e":43.287,"line":"s1","accent":false,"brk":false},{"w":"credit,","s":43.322,"e":43.683,"line":"s1","accent":true,"brk":false},{"w":"people","s":43.725,"e":43.946,"line":"s1","accent":false,"brk":true},{"w":"might","s":43.969,"e":44.131,"line":"s1","accent":false,"brk":false},{"w":"stop","s":44.166,"e":44.364,"line":"s1","accent":false,"brk":false},{"w":"sharing","s":44.398,"e":44.666,"line":"s1","accent":true,"brk":false},{"w":"it.","s":44.724,"e":45.734,"line":"s1","accent":false,"brk":false},{"w":"Want","s":45.017,"e":45.18,"line":"c1","accent":false,"brk":false},{"w":"to","s":45.203,"e":45.249,"line":"c1","accent":false,"brk":false},{"w":"understand","s":45.296,"e":45.725,"line":"c1","accent":false,"brk":false},{"w":"AI","s":45.783,"e":46.004,"line":"c1","accent":false,"brk":false},{"w":"like","s":46.05,"e":46.19,"line":"c1","accent":false,"brk":false},{"w":"this,","s":46.224,"e":46.596,"line":"c1","accent":false,"brk":false},{"w":"one","s":46.712,"e":46.863,"line":"c1","accent":true,"brk":true},{"w":"lesson","s":46.898,"e":47.107,"line":"c1","accent":true,"brk":false},{"w":"a","s":47.142,"e":47.165,"line":"c1","accent":false,"brk":false},{"w":"day?","s":47.211,"e":47.479,"line":"c1","accent":false,"brk":false},{"w":"Head","s":47.537,"e":47.699,"line":"c1","accent":false,"brk":true},{"w":"to","s":47.746,"e":47.804,"line":"c1","accent":false,"brk":false},{"w":"Teyro.","s":47.85,"e":48.512,"line":"c1","accent":true,"brk":false}],"lines":[{"id":"h1","start":0.12,"end":4.444,"text":"OpenAI just did decades of math in one release, and the best mathematicians alive are worried."},{"id":"i1a","start":4.544,"end":12.409,"text":"This week, OpenAI gave an unreleased model about 4,000 open problems. It cracked less than 10% of them, but that's still 372 results."},{"id":"i1b","start":12.509,"end":17.484,"text":"One of them is the Unique Games Conjecture, which Scott Aaronson says his wife spent her whole career working toward."},{"id":"i2","start":17.584,"end":22.733,"text":"OpenAI won't even name the model. Almost every result came from one prompt, with about three hours of thinking each."},{"id":"i3","start":22.833,"end":28.936,"text":"But here's the catch. Less than half of the proofs are checked by a computer, and nobody outside OpenAI can run the model to see how it got there."},{"id":"i4","start":29.036,"end":36.276,"text":"And these models learned from decades of papers mathematicians shared for free. That's why 25 Fields Medal winners signed a letter warning about plagiarism and credit."},{"id":"i5","start":36.376,"end":40.888,"text":"Terence Tao says the race to be first should matter less, and explaining a result should matter more."},{"id":"s1","start":40.988,"end":44.917,"text":"Because if sharing your work just trains a model that takes the credit, people might stop sharing it."},{"id":"c1","start":45.017,"end":48.332,"text":"Want to understand AI like this, one lesson a day? Head to Teyro."}],"lip":{"amp":[0,0,0,0,0.001,0.736,0.87,0.186,0.881,1,1,1,1,1,1,0.882,0.845,0.818,1,0.54,0.516,1,0.753,0.685,0.019,0.515,1,1,0.696,0.309,1,1,0.874,0.414,0.224,0.305,1,1,1,0.933,0.485,0.65,1,0.396,0.266,1,1,0.973,1,1,0.836,0.263,0.072,0.901,0.861,1,1,1,0.905,0.902,0.85,1,0.795,0.507,0.937,0.903,0.793,0.738,0.667,0.854,0.739,0.827,0.811,0.479,0.035,0.006,0.002,0.013,0.418,1,1,1,0.461,0.278,0.945,0.699,0.575,0.536,0.427,0.681,1,0.808,0.731,0.17,0.027,1,1,0.575,0.612,1,1,0.774,0.708,0.932,1,0.821,1,0.976,0.932,1,1,1,1,0.995,0.891,0.91,0.181,0.9,1,1,0.681,1,1,1,0.993,0.899,1,0.99,0.931,0.348,0.431,0.307,0.009,0.001,0,0,0.003,0.014,1,1,0.894,0.78,0.349,1,1,1,1,0.96,0.174,0.026,0.286,0.441,0.022,0.01,1,1,1,0.154,0.626,1,1,1,1,1,1,0.893,0.962,0.993,1,1,0.467,0.298,1,1,1,0.365,1,0.877,0.961,0.756,0.183,0.925,0.979,1,1,0.99,1,0.609,1,1,0.736,0.648,0.256,0.501,1,1,1,1,1,0.735,1,