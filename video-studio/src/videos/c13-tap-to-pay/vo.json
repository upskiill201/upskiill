1","accent":false,"brk":false},{"w":"Teyro.","s":42.751,"e":43.401,"line":"c1","accent":true,"brk":false}],"lines":[{"id":"h1","start":0.12,"end":3.971,"text":"One coffee. Six stops. Two seconds. And zero money moved."},{"id":"i1","start":4.071,"end":8.942,"text":"Stop one, your phone. Face ID unlocks a separate chip, a vault the rest of the phone can't read."},{"id":"i2","start":9.042,"end":15.764,"text":"Stop two, inside the vault. Not your card number, but a stand-in that only works on this phone. It signs this one purchase, so a copy is already dead."},{"id":"i3","start":15.864,"end":20.066,"text":"Stop three, the reader. NFC only reaches about four centimeters, that's why you have to touch it."},{"id":"i4","start":20.166,"end":24.594,"text":"Stop four, the shop's bank. It reads the first few digits, sees Visa, and passes it on."},{"id":"i5","start":24.694,"end":30.433,"text":"Stop five, Visa. It swaps the stand-in for your real number, and an AI checks over 500 signals in about one millisecond."},{"id":"i6","start":30.533,"end":35.575,"text":"Stop six, your bank. It checks the fraud score and your balance, and says yes. Beep. Coffee's yours."},{"id":"s1","start":35.675,"end":40.257,"text":"But no money moved. That beep was a promise. The real money moves later, in a batch called settlement."},{"id":"c1","start":40.357,"end":43.233,"text":"Want to build stuff like this, one lesson a day? Head to Teyro."}],"lip":{"amp":[0,0,0,0,0.08,0.969,0.55,0.62,0.463,0.714,1,1,1,0.756,0.36,0.227,1,1,1,1,1,0.844,0.425,0.014,0.016,0.001,0.021,0.534,0.81,0.948,0.659,0.305,0.929,0.793,0.654,0.359,0.998,0.906,1,1,1,0.541,0.078,0.661,0.77,0.748,0.597,0.321,0.021,0.001,0.001,0.035,0.82,1,1,0.852,0.751,0.85,0.567,0.219,0.409,0.693,0.739,0.542,0.395,0.479,0.946,1,0.81,0.803,0.77,0.208,0.021,0.074,0.084,0.06,0.02,0.001,0.509,1,1,1,1,0.919,1,1,1,1,1,1,0.898,1,1,0.841,1,1,0.953,0.886,0.616,0.173,0.019,0.001,0.045,0.838,1,1,1,0.975,0.909,0.871,0.666,0.592,0.606,0.497,0.056,0.714,0.834,0.1