# Copy to .env.local for local dev
# Set NEXT_PUBLIC_API_URL in Vercel Dashboard -> Environment Variables
NEXT_PUBLIC_API_URL=https://upskiill-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://upskiill.vercel.app

# AWS S3 + CloudFront Video Storage
AWS_REGION=eu-west-1
AWS_S3_BUCKET=teyro-course-videos
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret-key
CLOUDFRONT_URL=https://your-distribution.cloudfront.net
